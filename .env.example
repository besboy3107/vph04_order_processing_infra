# Учебные значения. Скопируйте в .env и замените на свои.

# PostgreSQL
POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=change-me-postgres

# pgAdmin (логин в веб-панель /pgadmin/)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin

# Docker Registry (docker login + create-user.sh)
REGISTRY_USER=admin
REGISTRY_PASSWORD=change-me-registry

# Порты и интервалы
NGINX_PORT=8080
REGISTRY_PORT=5000
WATCHTOWER_INTERVAL=300
