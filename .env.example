# Учебные значения. Скопируйте в .env и замените на свои.

# PostgreSQL
POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=change-me-postgres

# pgAdmin (логин в веб-панель /pgadmin/)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin

# Docker Registry (docker login + create-user.sh)
REGISTRY_USER=admin
REGISTRY_PASSWORD=change-me-registry

# Backend
# Swagger /api/docs: 0 — закрыт (рабочий режим), 1 — открыт для отладки.
BACKEND_DOCS_ENABLED=0
# JWT админ-панели (часть 3). Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-hex-32
JWT_TTL_HOURS=12

# Порты и интервалы
NGINX_PORT=8080
REGISTRY_PORT=5000
WATCHTOWER_INTERVAL=300
