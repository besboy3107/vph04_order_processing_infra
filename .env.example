# Учебные значения. Скопируйте в .env и замените на свои.

# PostgreSQL
POSTGRES_DB=orders
POSTGRES_USER=orders_app
POSTGRES_PASSWORD=change-me-postgres

# pgAdmin (логин в веб-панель /pgadmin/)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin

# Docker Registry (docker login + create-user.sh)
REGISTRY_USER=admin
REGISTRY_PASSWORD=change-me-registry

# Backend (часть 2)
# Swagger /api/docs: 0 — закрыт (по умолчанию), 1 — открыт для отладки.
BACKEND_DOCS_ENABLED=0
# Вход в админ-панель /admin (HTTP Basic)
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=change-me-admin

# Порты и интервалы
NGINX_PORT=8080
REGISTRY_PORT=5000
WATCHTOWER_INTERVAL=300
